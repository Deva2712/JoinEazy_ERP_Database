{
  "name": "joineazy-erp-database",
  "version": "1.0.0",
  "description": "Sequelize migrations and seeders for Joineazy ERP (PostgreSQL on AWS RDS)",
  "type": "module",
  "scripts": {
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "pg": "^8.13.0",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  }
}
